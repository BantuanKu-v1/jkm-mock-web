
{
  "name": "jkm-mock-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --local --port 8787",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:migrate:local": "wrangler d1 migrations apply jkm-mock-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply jkm-mock-db --remote",
    "test": "node --env-file=.dev.vars --test --test-concurrency=1 tests/*.test.mjs",
    "test:applications": "node --env-file=.dev.vars --test tests/applications.test.mjs",
    "test:admin": "node --env-file=.dev.vars --test tests/admin.test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "tail:api": "wrangler tail"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.106.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "wrangler": "^4.152.0"
  }
}
